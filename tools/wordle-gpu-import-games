SQUARE = {"🟩": "g", "🟧": "g", "🟨": "y", "🟦": "y", "⬛": "b", "⬜": "b"}


def log(*a):
	print(*a, file=sys.stderr, flush=True)


def feedback(g, a):
	"""The game's colours for guess g against answer a: greens first, then earlier
	letters take the remaining copies."""
	res = ["b"] * 5
	left = collections.Counter()
	for i in range(5):
		if g[i] == a[i]:
			res[i] = "g"
		else:
			left[a[i]] += 1
	for i in range(5):
		if res[i] != "g" and left[g[i]] > 0:
			res[i] = "y"
			left[g[i]] -= 1
	return "".join(res)


def valid_word(w):
	return len(w) == 5 and w.isascii() and w.isalpha() and w.islower()


class Lists:
	"""The word lists wordle-gpu is built with, plus newer NYT answers."""

	def __init__(self):
		here = os.path.dirname(os.path.realpath(__file__))
		for d in (os.path.join(here, "..", "data"), os.path.join(here, "..", "share", "wordle-gpu", "lists")):
			if os.path.exists(os.path.join(d, "allowed.txt")):
				break
		else:
			sys.exit("can't find wordle-gpu's word lists (data/ or share/wordle-gpu/lists/)")
		self.allowed = set(self._words(os.path.join(d, "allowed.txt")))
		self.by_date = {}
		for path in (os.path.join(d, "nyt-answers.txt"), os.path.join(DATA_HOME, "wordle-gpu", "nyt-answers.txt")):
			if os.path.exists(path):
				with open(path) as f:
					for line in f:
						p = line.split()
						if len(p) == 2 and not line.startswith("#") and valid_word(p[1]):
							self.by_date[dt.date.fromisoformat(p[0])] = p[1]
		self.allowed |= set(self.by_date.values())
		self._reach = {}

	@staticmethod
	def _words(path):
		with open(path) as f:
			return [w.strip().lower() for w in f if w.strip()]

	def answer(self, puzzle):
		return self.by_date.get(FIRST + dt.timedelta(puzzle)) if puzzle is not None else None

	def reachable(self, answer):
		"""Every colour row some allowed guess can get against answer."""
		r = self._reach.get(answer)
		if r is None:
			r = self._reach[answer] = {feedback(w, answer) for w in self.allowed}
		return r

	def check_colors(self, answer, colors):
		if not answer:
			return None
		r = self.reachable(answer)
		return int(all(c in r for c in colors))

	def check_words(self, answer, guesses, colors):
		if not answer:
			return None
		return int(all(g in self.allowed and feedback(g, answer) == c for g, c in zip(guesses, colors)))


def fetch(url, dest):
	"""Download url to dest unless it is already there."""
	if os.path.exists(dest):
		return dest
	os.makedirs(os.path.dirname(dest), exist_ok=True)
	log(f"  downloading {url}")
	req = urllib.request.Request(url, headers=UA)
	tmp = dest + ".part"
	with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
		total = int(r.headers.get("Content-Length") or 0)
		done, shown = 0, time.time()
		while chunk := r.read(1 << 20):
			f.write(chunk)
			done += len(chunk)
			if total and time.time() - shown > 2:
				log(f"    {done >> 20} of {total >> 20} MB")
				shown = time.time()
	os.replace(tmp, dest)
	return dest


def get_json(url, tries=4):
	req = urllib.request.Request(url, headers=UA)
	for attempt in range(tries):
		wait = 1 + 2 * attempt
		try:
			with urllib.request.urlopen(req, timeout=30) as r:
				return json.load(r)
		except urllib.error.HTTPError as e:
			if e.code in (403, 404):
				return None
			if e.code == 429:
				wait = max(int(e.headers.get("Retry-After") or 0), 15 * (attempt + 1))
			err = e
		except Exception as e:
			err = e
		time.sleep(wait)
	raise RuntimeError(f"{url}: {err}")


def kaggle(ref, dl):
	return fetch(f"https://www.kaggle.com/api/v1/datasets/download/{ref}", os.path.join(dl, ref.replace("/", "_") + ".zip"))


def zip_csv(path):
	"""The single CSV in a Kaggle zip, as dict rows."""
	csv.field_size_limit(1 << 26)
	z = zipfile.ZipFile(path)
	name = next(n for n in z.namelist() if n.endswith(".csv"))
	return csv.DictReader(io.TextIOWrapper(z.open(name), encoding="utf-8", newline=""))


class Players:
	"""Anonymous numbers in place of user names."""

	def __init__(self):
		self.ids = {}

	def __call__(self, name):
		if not name:
			return None
		return str(self.ids.setdefault(name, len(self.ids) + 1))


# A row: (puzzle, answer, hard, player, variant, result, guesses, colors, consistent)

TWEET = re.compile(r"Wordle\s+#?(\d[\d,.]*)\s+([1-6Xx])/6(\*?)")


def parse_share(text):
	"""(puzzle, result, hard, colour rows) from a shared Wordle result, or None."""
	m = TWEET.search(text)
	if not m:
		return None
	puzzle = int(re.sub(r"[,.]", "", m.group(1)))
	n = m.group(2)
	result = 0 if n in "Xx" else int(n)
	rows = []
	chat = 0  # lines of text between the header and the grid
	for line in text[m.end():].splitlines():
		line = line.replace("\ufe0f", "").strip()
		if len(line) >= 5 and all(c in SQUARE for c in line[:5]) and line[5:6] not in SQUARE:
			rows.append("".join(SQUARE[c] for c in line[:5]))
			if line[5:].strip():
				break  # text after the last row
		elif rows:
			break
		elif line:
			chat += 1
			if chat > 3:
				break
	return puzzle, result, int(bool(m.group(3))), rows


def good_grid(result, rows):
	if result:
		return len(rows) == result and rows[-1] == "ggggg" and "ggggg" not in rows[:-1]
	return len(rows) == 6 and "ggggg" not in rows


def tweets(lists, path, id_col, puzzle_col, user_col, text_col):
	players = Players()
	seen = set()
	bad = 0
	for r in zip_csv(path):
		tid = r.get(id_col)
		if tid in seen:
			continue
		seen.add(tid)
		text = r.get(text_col) or ""
		if text.startswith("RT @"):
			continue  # someone else's game
		p = parse_share(text)
		# A puzzle far from the day it was collected for is another game's share text.
		if not p or not good_grid(p[1], p[3]) or abs(p[0] - int(r[puzzle_col])) > 7:
			bad += 1
			continue
		puzzle, result, hard, rows = p
		answer = lists.answer(puzzle)
		yield (puzzle, answer, hard, players(r.get(user_col)), None, result, None, " ".join(rows),
			lists.check_colors(answer, rows))
	log(f"  skipped {bad} tweets without a readable Wordle grid")


def import_tweets_calvet(lists, dl):
	path = kaggle("scarcalvetsis/wordle-games", dl)
	players = Players()
	bad = 0
	for r in zip_csv(path):
		rows = ["".join(SQUARE.get(c, "?") for c in s.replace("\ufe0f", ""))
			for s in re.findall(r"'([^']*)'", r["processed_text"])]
		trial = int(r["Trial"])
		result = trial if trial <= 6 else 0
		if not good_grid(result, rows):
			bad += 1
			continue
		puzzle = int(r["Game"])
		answer = (r["target"] or "").strip().lower() or lists.answer(puzzle)
		yield (puzzle, answer, None, players(r["Username"]), None, result, None, " ".join(rows),
			lists.check_colors(answer, rows))
	log(f"  skipped {bad} malformed games")


