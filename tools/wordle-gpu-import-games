def import_sim_hohmann(lists, dl):
	path = kaggle("lucashohmann/wordle-random-simulations", dl)
	hit = {"c": "g", "m": "y", "_": "b"}
	for r in zip_csv(path):
		answer = r["solution"].strip()
		guesses, colors = [], []
		for i in range(6):
			g = (r.get(f"attempt_{i}") or "").strip()
			if not g:
				break
			guesses.append(g)
			colors.append("".join(hit.get(c, "?") for c in r[f"hits_{i}"].strip()))
		if not guesses:
			continue
		result = len(guesses) if guesses[-1] == answer else 0
		yield (None, answer, None, None, None, result, " ".join(guesses), " ".join(colors),
			lists.check_words(answer, guesses, colors))


def import_lmrl_gym(lists, dl):
	base = "https://rail.eecs.berkeley.edu/datasets/rl-llm-bench-dataset/wordle/"
	vocab = fetch("https://raw.githubusercontent.com/abdulhaim/LMRL-Gym/main/llm_rl_scripts/wordle/vocab/"
		"wordle_official_400.txt", os.path.join(dl, "lmrl-gym", "wordle_official_400.txt"))
	with open(vocab) as f:
		pool = [w.strip() for w in f if valid_word(w.strip())]
	# LMRL-Gym's own colours: unlike the game, every extra copy of a letter in the answer shows
	# yellow. Inferring a failed game's answer has to use them; the consistency check uses the game's.
	def lmrl_feedback(g, a):
		return "".join("g" if g[i] == a[i] else "y" if g[i] in a else "b" for i in range(5))
	groups = {}  # guess -> colours -> the pool words giving them

	def fits(g, c):
		if g not in groups:
			groups[g] = collections.defaultdict(set)
			for w in pool:
				groups[g][lmrl_feedback(g, w)].add(w)
		return groups[g].get(c, set())
	for split in ("train", "eval"):
		path = fetch(base + f"{split}_data.jsonl", os.path.join(dl, "lmrl-gym", f"{split}_data.jsonl"))
		with open(path) as f:
			for line in f:
				seq = json.loads(line)["sequence"]
				guesses, colors = [], []
				for i, (text, weight) in enumerate(seq):
					if weight == 1.0 and i + 1 < len(seq):
						guesses.append(text.replace(" ", "").strip())
						colors.append(seq[i + 1][0].replace(" ", "").strip())
				if not guesses:
					continue
				solved = colors[-1] == "ggggg"
				answer = guesses[-1] if solved else None
				if not answer:
					left = set.intersection(*(fits(g, c) for g, c in zip(guesses, colors)))
					answer = next(iter(left)) if len(left) == 1 else None
				result = len(guesses) if solved else 0 if len(guesses) >= 6 else None
				yield (None, answer, 0, None, split, result, " ".join(guesses), " ".join(colors),
					lists.check_words(answer, guesses, colors))


GUESS = re.compile(r"guess:\s*([A-Za-z]+)")
KTO_COLOR = {"green": "g", "yellow": "y", "red": "b"}


def kto_rows(dl):
	"""KTO_FINAL's rows: from its parquet file if pyarrow is installed, else through
	Hugging Face's rows API (slow: it rate-limits)."""
	try:
		import pyarrow.parquet as pq
	except ImportError:
		pq = None
	if pq:
		path = fetch("https://huggingface.co/datasets/clembench-playpen/KTO_FINAL/resolve/main/data/"
			"train-00000-of-00001.parquet", os.path.join(dl, "clembench-kto", "train.parquet"))
		yield from pq.read_table(path).to_pylist()
		return
	path = os.path.join(dl, "clembench-kto", "rows.jsonl")
	if not os.path.exists(path):
		os.makedirs(os.path.dirname(path), exist_ok=True)
		api = "https://datasets-server.huggingface.co/rows?dataset=clembench-playpen/KTO_FINAL&config=default&split=train"
		log(f"  downloading {api} (install pyarrow to read the parquet file instead)")
		with open(path + ".part", "w") as f:
			offset, total = 0, None
			while total is None or offset < total:
				page = get_json(f"{api}&offset={offset}&length=100", tries=8)
				total = page["num_rows_total"]
				for r in page["rows"]:
					f.write(json.dumps(r["row"]) + "\n")
				offset += 100
				time.sleep(0.5)
		os.replace(path + ".part", path)
	with open(path) as f:
		for line in f:
			yield json.loads(line)


def import_clembench_kto(lists, dl):
	# Each row is one turn: the transcript so far and the next reply. Keep the longest per episode.
	episodes = {}
	for r in kto_rows(dl):
		if not r["game"].startswith("wordle"):
			continue
		key = (r["game"], r["model"], r["benchmark_version"], r["experiment"], r["episode"], r["game_id"])
		if key not in episodes or len(r["prompt"]) > len(episodes[key]["prompt"]):
			episodes[key] = r
	for (game, model, version, experiment, _, _), r in sorted(episodes.items()):
		answer = r["target"].strip().lower()
		msgs = r["prompt"] + r["completion"]
		critic = "critic" in game
		guesses, shown = [], []
		for i, m in enumerate(msgs):
			g = GUESS.search(m["content"]) if m["role"] == "assistant" else None
			if not g:
				continue
			word = g.group(1).lower()
			nxt = msgs[i + 1]["content"] if i + 1 < len(msgs) else None
			if nxt is not None and "guess_feedback" in nxt:
				guesses.append(word)
				shown.append("".join(KTO_COLOR.get(c, "?") for c in re.findall(r"<(\w+)>", nxt)))
			elif nxt is None and word in lists.allowed and (not critic or "guess_agreement" in msgs[i - 1]["content"]):
				# The final reply: played, but its colours aren't in the record.
				guesses.append(word)
				shown.append(None)
		if not guesses or len(guesses) > 6 or not all(g in lists.allowed for g in guesses):
			continue
		colors = [feedback(g, answer) for g in guesses]
		consistent = int(all(s is None or s == c for s, c in zip(shown, colors)))
		result = len(guesses) if guesses[-1] == answer else 0 if len(guesses) == 6 else None
		yield (None, answer, 0, model, f"{game}/{experiment}", result, " ".join(guesses), " ".join(colors),
			consistent)


def align_steps(steps, average):
	"""WordleBot's guess counts as 1..6 then failed. Full arrays have 7 entries; older ones
	are cut short at either end, so place them where they give the summary's own average
	(it charges a failure 7 to 7.5). None if no placement fits."""
	if len(steps) == 7:
		return list(steps)
	if not steps or len(steps) > 7 or average is None or not sum(steps):
		return None
	best = None
	for off in range(8 - len(steps)):
		n = [0] * off + list(steps) + [0] * (7 - off - len(steps))
		for fail in (7, 7.5):
			avg = (sum((i + 1) * c for i, c in enumerate(n[:6])) + fail * n[6]) / sum(n)
			if best is None or abs(avg - average) < best[0]:
				best = (abs(avg - average), n)
	return best[1] if best[0] < 0.02 else None


def daily_wordlebot(lists, dl, db, src, through, refresh):
	have = set() if refresh else {d for (d,) in db.execute("SELECT DISTINCT date FROM daily WHERE source=?", (src,))}
	days = [d for d, w in sorted(lists.by_date.items()) if d <= through and d.isoformat() not in have]
	log(f"  fetching {len(days)} days through {through}")

	cache = os.path.join(dl, "nyt-wordlebot")
	os.makedirs(cache, exist_ok=True)

	def one(day):
		w = lists.by_date[day]
		path = os.path.join(cache, f"{w}-{day.isoformat()}.json")
		if os.path.exists(path):
			with open(path) as f:
				return day, w, json.load(f)
		d = get_json(f"https://static01.nyt.com/newsgraphics/2022/wordlebot/{w}-{day.isoformat()}/summary.json")
		if d is not None:
			with open(path + ".part", "w") as f:
				json.dump(d, f)
			os.replace(path + ".part", path)
		return day, w, d

	rows, missing = [], 0
	with ThreadPoolExecutor(max_workers=4) as pool:
		for i, (day, w, d) in enumerate(pool.map(one, days), 1):
			if i % 200 == 0:
				log(f"    {i}/{len(days)}")
			if not isinstance(d, dict) or not isinstance(d.get("steps"), dict):
				missing += 1
				continue
			for mode, steps in d["steps"].items():
				if not isinstance(steps, list) or not all(isinstance(x, (int, float)) for x in steps):
					continue
				avg = d.get("average")
				avg = avg.get(mode) if isinstance(avg, dict) else None
				n = align_steps(steps, avg) or [None] * 7
				extra = {k: v.get(mode) if isinstance(v, dict) else v for k, v in d.items() if k != "steps"}
				extra["guesses"] = {k: v for k, v in (d.get("guesses") or {}).items() if k.startswith(mode)}
				extra["steps"] = steps
				rows.append((src, day.isoformat(), (day - FIRST).days, w, mode, sum(steps), None, *n, 0, avg,
					json.dumps(extra)))
	if missing:
		log(f"  no summary for {missing} days")
	return rows


def daily_mcm(lists, dl, db, src, through, refresh):
	path = fetch("https://raw.githubusercontent.com/arusli1/MCM-Wordle-Prediction/main/data/2023_MCM_Problem_C_Data.csv",
		os.path.join(dl, "mcm-2023", "2023_MCM_Problem_C_Data.csv"))
	rows = []
	with open(path, newline="", encoding="utf-8") as f:
		for r in csv.reader(f):
			if not r or not r[0][:1].isdigit():
				continue
			day = dt.date.fromisoformat(r[0])
			answer = lists.by_date.get(day)
			extra = {"word_as_given": r[2].strip()} if r[2].strip().lower() != answer else {}
			pct = [float(x) for x in r[5:12]]
			avg = sum((i + 1) * p for i, p in enumerate(pct)) / (sum(pct) or 1)
			rows.append((src, day.isoformat(), int(r[1]), answer, "all", int(r[3]), int(r[4]), *pct, 1, avg,
				json.dumps(extra) if extra else None))
	return rows


GAME_IMPORTS = {
	"tweets-calvet": import_tweets_calvet,
	"tweets-hamner": import_tweets_hamner,
	"tweets-vora": import_tweets_vora,
	"sim-hohmann": import_sim_hohmann,
	"lmrl-gym": import_lmrl_gym,
	"clembench-kto": import_clembench_kto,
}
DAILY_IMPORTS = {"nyt-wordlebot": daily_wordlebot, "mcm-2023": daily_mcm}


def open_db(path):
	os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
	db = sqlite3.connect(path)
	db.executescript(SCHEMA)
	db.execute("INSERT OR REPLACE INTO meta VALUES('schema', ?)", (str(SCHEMA_VERSION),))
	db.commit()
	return db


def source_id(db, name):
	s = SOURCES[name]
	db.execute("INSERT INTO sources(name, title, url, license, kind, notes) VALUES(?,?,?,?,?,?) "
		"ON CONFLICT(name) DO UPDATE SET title=excluded.title, url=excluded.url, license=excluded.license, "
		"kind=excluded.kind, notes=excluded.notes",
		(name, s["title"], s["url"], s["license"], s["kind"], s["notes"]))
	return db.execute("SELECT id FROM sources WHERE name=?", (name,)).fetchone()[0]


def import_games(db, name, lists, dl):
	src = source_id(db, name)
	if db.execute("SELECT 1 FROM sqlite_master WHERE name='turn_eval'").fetchone():
		db.execute("DELETE FROM turn_eval WHERE game IN (SELECT id FROM games WHERE source=?)", (src,))
	db.execute("DELETE FROM games WHERE source=?", (src,))
	n = 0
	batch = []
	insert = ("INSERT INTO games(source, puzzle, answer, hard, player, variant, result, guesses, colors, consistent) "
		"VALUES(?,?,?,?,?,?,?,?,?,?)")
	for row in GAME_IMPORTS[name](lists, dl):
		batch.append((src, *row))
		if len(batch) >= 50000:
			db.executemany(insert, batch)
			n += len(batch)
			batch.clear()
			if n % 500000 == 0:
				log(f"    {n} games")
	db.executemany(insert, batch)
	n += len(batch)
	return n


def import_daily(db, name, lists, dl, through, refresh):
	src = source_id(db, name)
	rows = DAILY_IMPORTS[name](lists, dl, db, src, through, refresh)
	if refresh:
		db.execute("DELETE FROM daily WHERE source=?", (src,))
	db.executemany("INSERT OR REPLACE INTO daily VALUES(" + ",".join("?" * 17) + ")", rows)
	return len(rows)


def main():
	ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
	ap.add_argument("sources", nargs="*", metavar="SOURCE",
		help="sources to import (default all): " + ", ".join(SOURCES))
	ap.add_argument("-l", "--list", action="store_true", help="list the sources and exit")
	ap.add_argument("--db", default=DEFAULT_DB, help=f"database (default {DEFAULT_DB})")
	ap.add_argument("--downloads", default=DEFAULT_DOWNLOADS,
		help=f"where downloads are kept for re-imports (default {DEFAULT_DOWNLOADS})")
	ap.add_argument("--through", type=dt.date.fromisoformat, default=dt.date.today() - dt.timedelta(days=1),
		help="last day of daily statistics, YYYY-MM-DD (default yesterday)")
	ap.add_argument("--refresh", action="store_true",
		help="re-fetch every day of the daily statistics, not just the missing ones")
	args = ap.parse_args()

	if args.list:
		for name, s in SOURCES.items():
			print(f"{name:14} {s['kind']:9} {s['license']:22} {s['title']}\n{'':15}{s['url']}\n{'':15}{s['notes']}")
		return 0
	names = args.sources or list(SOURCES)
	for n in names:
		if n not in SOURCES:
			ap.error(f"unknown source {n!r}; see --list")

	lists = Lists()
	db = open_db(args.db)
	db.execute("PRAGMA synchronous=OFF")
	failed = []
	for name in names:
		log(f"{name}: {SOURCES[name]['title']}")
		t0 = time.time()
		try:
			if name in GAME_IMPORTS:
				n = import_games(db, name, lists, args.downloads)
				what = "games"
			else:
				n = import_daily(db, name, lists, args.downloads, min(args.through, dt.date.today()), args.refresh)
				what = "daily rows"
			db.execute("UPDATE sources SET imported=? WHERE name=?",
				(dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ"), name))
			db.commit()
			log(f"  {n} {what} in {time.time() - t0:.0f} s")
		except Exception as e:
			db.rollback()
			log(f"  failed: {e}")
			failed.append(name)
	db.executescript(INDEXES)
	db.execute("ANALYZE")
	db.commit()
	db.close()
	log(f"database: {args.db}")
	if failed:
		log("failed: " + " ".join(failed))
	return 1 if failed else 0


if __name__ == "__main__":
	sys.exit(main())
